#!/bin/sh
set -eu

api_level="${ANDROID_API_LEVEL:-28}"
export BINDGEN_EXTRA_CLANG_ARGS_armv7_linux_androideabi="${BINDGEN_EXTRA_CLANG_ARGS_armv7_linux_androideabi:+$BINDGEN_EXTRA_CLANG_ARGS_armv7_linux_androideabi }-D__ANDROID_MIN_SDK_VERSION__=$api_level"
export BINDGEN_EXTRA_CLANG_ARGS_aarch64_linux_android="${BINDGEN_EXTRA_CLANG_ARGS_aarch64_linux_android:+$BINDGEN_EXTRA_CLANG_ARGS_aarch64_linux_android }-D__ANDROID_MIN_SDK_VERSION__=$api_level"
export BINDGEN_EXTRA_CLANG_ARGS_x86_64_linux_android="${BINDGEN_EXTRA_CLANG_ARGS_x86_64_linux_android:+$BINDGEN_EXTRA_CLANG_ARGS_x86_64_linux_android }-D__ANDROID_MIN_SDK_VERSION__=$api_level"

cargo_bin=$(command -v cargo)
unset CARGO
exec "$cargo_bin" "$@"
